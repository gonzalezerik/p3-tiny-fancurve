#!/usr/bin/env python3
"""Fixed fan speed for the Lenovo ThinkStation P3 Tiny Gen 2.

The fan belongs to the ITE EC; Linux gets no PWM. The EC's fan level is
selected by a flag byte in its banked RAM (BRAM index 0x0e, reached through
the firmware's own \\_SB.GBRM / \\_SB.SBRM methods via acpi_call). 0x1f is the
EC's normal auto curve; clearing a single bit pins a fixed level:

  low     0x1e  ~2,000 rpm
  medium  0x0f  ~2,400 rpm
  full    0x1d  ~5,970 rpm   (same as the BIOS "Full Speed" mode)
  max     0x17  ~6,950 rpm
  auto    0x1f  EC curve (~900 rpm until the CPU is in the 90s)

Fan tach is EC RAM 0x09/0x0A, read through \\_SB.GECR.

  p3-fancurve run      daemon (systemd): hold LEVEL, re-assert if changed
  p3-fancurve status   one-shot readout
  p3-fancurve set {low|medium|full|max|auto}
"""
import os, signal, sys, time

CALL = "/proc/acpi/call"
FLAG = 0x0E
LEVELS = {"low": 0x1E, "medium": 0x0F, "full": 0x1D, "max": 0x17, "auto": 0x1F}
NAMES = {v: k for k, v in LEVELS.items()}
PKG_TEMP = None  # resolved at start: thermal zone of type x86_pkg_temp

# LEVEL is held constantly. Only if the CPU reaches SAFETY_TEMP does the fan go
# to full, and it returns to LEVEL once the CPU is back below SAFETY_CLEAR.
CFG = {"LEVEL": "medium", "SAFETY_TEMP": 90, "SAFETY_CLEAR": 75, "INTERVAL": 5}


def load_cfg():
    try:
        for line in open("/etc/default/p3-fancurve"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = (x.strip() for x in line.split("=", 1))
                if k in CFG:
                    CFG[k] = v if k == "LEVEL" else int(v)
    except FileNotFoundError:
        pass
    if CFG["LEVEL"] not in LEVELS:
        raise ValueError(f"LEVEL must be one of {', '.join(LEVELS)}")


def acpi(expr):
    with open(CALL, "w") as f:
        f.write(expr)
    with open(CALL) as f:
        out = f.read().strip("\0\n ")
    if out.startswith("Error"):
        raise RuntimeError(f"{expr}: {out}")
    return int(out, 16) if out.startswith("0x") else int(out)


def ec(addr):
    return acpi(f"\\_SB.GECR 0x{addr:02x}")


def rpm():
    return (ec(0x0A) << 8) | ec(0x09)


def get_flag():
    return acpi(f"\\_SB.GBRM 0x{FLAG:02x}")


def set_level(name):
    acpi(f"\\_SB.SBRM 0x{FLAG:02x} 0x{LEVELS[name]:02x}")


def pkg_zone():
    for z in sorted(os.listdir("/sys/class/thermal")):
        p = f"/sys/class/thermal/{z}"
        try:
            if open(f"{p}/type").read().strip() == "x86_pkg_temp":
                return f"{p}/temp"
        except OSError:
            continue
    raise RuntimeError("no x86_pkg_temp thermal zone")


def cpu_temp():
    return int(open(PKG_TEMP).read()) / 1000


def run():
    load_cfg()
    set_level(CFG["LEVEL"])
    hot = False

    def stop(*_):
        # Clean stop: hand the fan back to the EC's own curve.
        try:
            set_level("auto")
        finally:
            sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    print(f"start: {CFG}", flush=True)
    while True:
        t = cpu_temp()
        if not hot and t >= CFG["SAFETY_TEMP"]:
            hot = True
            print(f"{t:.0f}C: safety override, full speed", flush=True)
        elif hot and t < CFG["SAFETY_CLEAR"]:
            hot = False
            print(f"{t:.0f}C: back to {CFG['LEVEL']}", flush=True)
        level = "full" if hot and CFG["LEVEL"] not in ("full", "max") else CFG["LEVEL"]
        if get_flag() != LEVELS[level]:
            # The BIOS/EC rewrote the flag byte (e.g. after a mode change); re-assert.
            set_level(level)
        time.sleep(CFG["INTERVAL"])


def check_model():
    # The ACPI paths and EC offsets are specific to this board's firmware.
    try:
        family = open("/sys/class/dmi/id/product_family").read().strip()
    except OSError:
        family = "unknown"
    if family != "ThinkStation P3 Tiny Gen 2" and os.environ.get("P3_FANCURVE_FORCE") != "1":
        sys.exit(f"unsupported machine ({family}); set P3_FANCURVE_FORCE=1 to override")


def main():
    global PKG_TEMP
    check_model()
    if not os.path.exists(CALL):
        os.system("modprobe acpi_call")
    PKG_TEMP = pkg_zone()
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "run":
        try:
            run()
        except Exception as e:
            print(f"error: {e}; forcing full speed", file=sys.stderr, flush=True)
            try:
                set_level("full")
            finally:
                sys.exit(1)
    elif cmd == "set" and len(sys.argv) == 3 and sys.argv[2] in LEVELS:
        set_level(sys.argv[2])
    elif cmd == "status":
        flag = get_flag()
        print(f"level={NAMES.get(flag, hex(flag))} fan={rpm()}rpm cpu={cpu_temp():.0f}C")
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
